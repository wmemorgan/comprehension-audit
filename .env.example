# Required — LLM Provider
LLM_API_KEY=your-anthropic-api-key-here
LLM_MODEL=claude-sonnet-4-20250514

# Optional — Email Provider (Brevo)
# Remove or leave empty to use ConsoleRouter (no email integration)
EMAIL_API_KEY=your-brevo-api-key-here
EMAIL_LIST_IDS=comma-separated-list-ids

# Optional — CRM attribute name mapping
# The pipeline writes these scoring attributes onto the CRM contact (and reads
# the submitted-at one back for rate limiting). Defaults are neutral AUDIT_*
# names. Set these only if your CRM already defines differently-named attributes
# you want to reuse — no code change required.
# CRM_ATTR_SCORE=AUDIT_SCORE
# CRM_ATTR_BAND=AUDIT_BAND
# CRM_ATTR_STRONGEST=AUDIT_STRONGEST
# CRM_ATTR_WEAKEST=AUDIT_WEAKEST
# CRM_ATTR_REPORT_URL=AUDIT_REPORT_URL
# CRM_ATTR_SUBMITTED_AT=AUDIT_SUBMITTED_AT

# Optional — Pipeline Webhook
# Remove or leave empty to skip webhook notifications
PIPELINE_WEBHOOK_URL=https://your-webhook-endpoint.com/audit-results

# Optional — Frontend
REPORT_BASE_URL=http://localhost:4321/audit/reports
PUBLIC_AUDIT_API_URL=/api/audit-submit

# Optional — CORS
ALLOWED_ORIGIN=http://localhost:4321
